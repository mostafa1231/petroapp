# ─────────────────────────────────────────────────────────────
# PetroApp Egypt landing page — environment variables
# Every integration is optional: if a key is missing the step is
# skipped (and logged), so the page always works and leads are
# always written somewhere. NEXT_PUBLIC_* values are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=https://eg.petroapp.com            # [DOMAIN]
NEXT_PUBLIC_WHATSAPP_E164=+201222244141                 # [WHATSAPP_E164] confirm it is the sales line
NEXT_PUBLIC_SALES_PHONE_E164=+201222244141              # [SALES_PHONE]
NEXT_PUBLIC_PRIVACY_POLICY_URL=https://petroapp.com/privacy   # [PRIVACY_POLICY_URL]
NEXT_PUBLIC_BOOKING_URL=                                # [BOOKING_URL] Cal.com / Calendly / HubSpot Meetings link (shown to tier A/B on thank-you)
NEXT_PUBLIC_VIDEO_YOUTUBE_ID=                           # [VIDEO_URL] YouTube video id only

# Security (REQUIRED in production) — signs the thank-you token
LEAD_TOKEN_SECRET=change-me-to-a-long-random-string

# Tag management / analytics
NEXT_PUBLIC_GTM_ID=                                     # [GTM_ID] GTM-XXXXXXX
GA4_MEASUREMENT_ID=                                     # [GA4_MEASUREMENT_ID] G-XXXXXXX (server Measurement Protocol)
GA4_API_SECRET=                                         # [GA4 API_SECRET]

# Meta Conversions API (Pixel itself is loaded via GTM)
META_PIXEL_ID=                                          # [META_PIXEL_ID]
META_CAPI_TOKEN=                                        # [META_CAPI_TOKEN]
META_TEST_EVENT_CODE=                                   # set only while testing in Events Manager

# Google Ads offline stages (conversion action resource names, used by /api/crm/stage)
GOOGLE_ADS_CONVERSION_APPOINTMENT=
GOOGLE_ADS_CONVERSION_QUALIFIED=
GOOGLE_ADS_CONVERSION_WON=

# CRM + lead routing
CRM_WEBHOOK_URL=                                        # [CRM_WEBHOOK_URL] Zapier/Make/HubSpot workflow/Zoho Flow/custom
CRM_API_KEY=                                            # optional Bearer token for the webhook
CRM_STAGE_WEBHOOK_SECRET=                               # shared secret your CRM sends to /api/crm/stage
BACKUP_WEBHOOK_URL=                                     # Google Apps Script web app → Sheet (see README)
BACKUP_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=                                      # [SALES alert Slack webhook]
RESEND_API_KEY=                                         # email alerts via resend.com
SALES_ALERT_EMAILS=                                     # [SALES_ALERT_EMAILS] comma-separated
ALERT_FROM_EMAIL=PetroApp Leads <leads@petroapp.com>

# WhatsApp Cloud API auto-message (needs an approved template with {{1}} = first name)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# Anti-spam
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                         # [TURNSTILE_KEYS]
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=                                 # rate limit + 24h duplicate-phone check (in-memory fallback otherwise)
UPSTASH_REDIS_REST_TOKEN=
